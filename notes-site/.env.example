LOCAL_OCR_DOWNLOAD_ENABLED=1
# Supabase Connect → Session pooler 또는 Direct connection
# DJANGO_DATABASE_URL=
# 접속 주소에 비밀번호를 넣지 않았다면 아래 줄에 입력합니다.
# DJANGO_DATABASE_PASSWORD=
# 공개 서버 환경 변수
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=your-host.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-host.example.com
# DJANGO_BEHIND_HTTPS_PROXY=1
